<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>WeekendDrops</RootNamespace>
    <AssemblyName>WeekendDrops</AssemblyName>
    <Version>1.0.7</Version>
    <AssemblyVersion>1.0.7</AssemblyVersion>
    <FileVersion>1.0.7</FileVersion>
    <Authors>20fpsguy</Authors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
    <!-- Blazor host + MudBlazor: the launcher's Mod Pages config screen renders into this. -->
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.0" />
  </ItemGroup>

  <!-- Use the server's own Harmony (Private=false: don't copy, avoid version clash) -->
  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>D:\SPT 4.1 dev\SPT_Runtime\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- The cloned WTT-ContentBackport repo lives in-tree for reference only; never compile it. -->
  <ItemGroup>
    <Compile Remove="Tarkov-1.0-Backport\**\*.cs" />
    <Content Remove="Tarkov-1.0-Backport\**" />
    <None Remove="Tarkov-1.0-Backport\**" />
    <EmbeddedResource Remove="Tarkov-1.0-Backport\**" />
  </ItemGroup>

  <!-- The cloned SPT-DynamicMaps repo lives in-tree for API reference only; never compile it. -->
  <ItemGroup>
    <Compile Remove="SPT-DynamicMaps\**\*.cs" />
    <Content Remove="SPT-DynamicMaps\**" />
    <None Remove="SPT-DynamicMaps\**" />
    <EmbeddedResource Remove="SPT-DynamicMaps\**" />
  </ItemGroup>

  <!-- deploy to SPT on build - copies DLL + content config files automatically.
       config.json is the user-tunable settings file (debugMode etc.); it is NOT in
       the blanket copy so a rebuild never clobbers the deployed settings. It's only
       seeded when missing (fresh install). -->
  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <MakeDir Directories="D:\SPT 4.1 dev\SPT_Runtime\user\mods\WeekendDrops\config" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="D:\SPT 4.1 dev\SPT_Runtime\user\mods\WeekendDrops" />
    <!-- Debug builds emit these next to the dll; the Blazor host reads them to serve the mod
         page. Release turns them off (see below), hence the Exists guard. -->
    <ItemGroup>
      <_WebAssets Include="$(TargetDir)$(AssemblyName).staticwebassets.*.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_WebAssets)" DestinationFolder="D:\SPT 4.1 dev\SPT_Runtime\user\mods\WeekendDrops"
          Condition="'@(_WebAssets)' != ''" />
    <ItemGroup>
      <_ConfigFiles Include="$(ProjectDir)config\*.*" Exclude="$(ProjectDir)config\config.json" />
    </ItemGroup>
    <Copy SourceFiles="@(_ConfigFiles)" DestinationFolder="D:\SPT 4.1 dev\SPT_Runtime\user\mods\WeekendDrops\config" />
    <Copy SourceFiles="$(ProjectDir)config\config.json"
          DestinationFolder="D:\SPT 4.1 dev\SPT_Runtime\user\mods\WeekendDrops\config"
          Condition="!Exists('D:\SPT 4.1 dev\SPT_Runtime\user\mods\WeekendDrops\config\config.json')" />
    <!-- Custom bot data. We read db\bots\types from the mod folder ourselves (see
         WeekendDropsLoader.LoadContractBotTypes) and override the matching vanilla bot
         type, so cursedassault.json lands at ...\WeekendDrops\db\bots\types\. -->
    <ItemGroup>
      <_BotFiles Include="$(ProjectDir)db\**\*.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_BotFiles)"
          DestinationFiles="@(_BotFiles->'D:\SPT 4.1 dev\SPT_Runtime\user\mods\WeekendDrops\db\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- The razor pages compile into the assembly and MudBlazor comes from the server's own
       Blazor host, so a release ships one dll: no static-asset manifests, no deps file. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>
</Project>
