<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>WeekendDrops</RootNamespace>
    <AssemblyName>WeekendDrops</AssemblyName>
    <Version>1.0.8</Version>
    <AssemblyVersion>1.0.8</AssemblyVersion>
    <FileVersion>1.0.8</FileVersion>
    <Authors>20fpsguy; Project Brainiac</Authors>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup Condition="'$(SptRoot)' == ''">
    <PackageReference Include="SPTarkov.Common" Version="4.1.0" />
    <PackageReference Include="SPTarkov.DI" Version="4.1.0" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.1.0" />
    <!-- Blazor host + MudBlazor: the launcher's Mod Pages config screen renders into this. -->
    <PackageReference Include="SPTarkov.Server.Web" Version="4.1.0" />
  </ItemGroup>

  <!-- Use the server's own Harmony (Private=false: don't copy, avoid version clash) -->
  <ItemGroup>
    <Reference Include="0Harmony">

      <HintPath Condition="'$(SptRoot)' != ''">$(SptRoot)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="config\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Local tooling and generated test data must never become mod content. -->
  <ItemGroup>
    <Content Remove="development/**;tests/**;tests-localization/**;tests-maintenance/**;tests-audio/**;client-audio/**;client-preview/**;client-issues/**;client-layout/**;localization/**;scripts/**;docs/**" />
    <None Remove="development/**;tests/**;tests-localization/**;tests-maintenance/**;tests-audio/**;client-audio/**;client-preview/**;client-issues/**;client-layout/**;localization/**;scripts/**;docs/**" />
  </ItemGroup>

  <!-- The cloned WTT-ContentBackport repo lives in-tree for reference only; never compile it. -->
  <ItemGroup>
    <Compile Remove="development/**"/>
    <Compile Remove="tests/**"/>
    <Compile Remove="tests-audio/**"/>
    <Compile Remove="client-audio/**"/>
    <Compile Remove="client-preview/**"/>
    <Compile Remove="tests-maintenance/**"/>
    <Compile Remove="tests-localization/**"/>
    <Compile Remove="client-issues/**"/>
    <Compile Remove="client-layout/**"/>
    <Compile Remove="Tarkov-1.0-Backport\**\*.cs" />
    <Content Remove="Tarkov-1.0-Backport\**" />
    <None Remove="Tarkov-1.0-Backport\**" />
    <EmbeddedResource Remove="Tarkov-1.0-Backport\**" />
  </ItemGroup>

  <!-- The cloned SPT-DynamicMaps repo lives in-tree for API reference only; never compile it. -->
  <ItemGroup>
    <Compile Remove="SPT-DynamicMaps\**\*.cs" />
    <Content Remove="SPT-DynamicMaps\**" />
    <None Remove="SPT-DynamicMaps\**" />
    <EmbeddedResource Remove="SPT-DynamicMaps\**" />
  </ItemGroup>

  <!-- Building never writes to an installed game. Use the release archive to deploy. -->

  <!-- The razor pages compile into the assembly and MudBlazor comes from the server's own
       Blazor host, so a release ships one dll: no static-asset manifests, no deps file. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>None</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <ItemGroup Condition="'$(SptRoot)' != ''">
    <Reference Include="SPTarkov.Common" HintPath="$(SptRoot)/SPTarkov.Common.dll" Private="false"/>
    <Reference Include="SPTarkov.DI" HintPath="$(SptRoot)/SPTarkov.DI.dll" Private="false"/>
    <Reference Include="SPTarkov.Server.Core" HintPath="$(SptRoot)/SPTarkov.Server.Core.dll" Private="false"/>
    <Reference Include="SPTarkov.Server.Web" HintPath="$(SptRoot)/SPTarkov.Server.Web.dll" Private="false"/>
    <Reference Include="SemanticVersioning" HintPath="$(SptRoot)/SemanticVersioning.dll" Private="false"/>
    <Reference Include="Spectre.Console.Ansi" HintPath="$(SptRoot)/Spectre.Console.Ansi.dll" Private="false"/>
    <Reference Include="Spectre.Console" HintPath="$(SptRoot)/Spectre.Console.dll" Private="false"/>
    <Reference Include="MudBlazor" HintPath="$(SptRoot)/MudBlazor.dll" Private="false"/>
  </ItemGroup>
</Project>
